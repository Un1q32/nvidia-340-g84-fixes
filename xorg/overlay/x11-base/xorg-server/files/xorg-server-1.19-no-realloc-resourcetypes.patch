--- a/dix/resource.c
+++ b/dix/resource.c
@@ -121,6 +121,7 @@
 #include <dix-config.h>
 #endif
 
+#include <stdlib.h>
 #include <X11/X.h>
 #include "misc.h"
 #include "os.h"
@@ -510,9 +511,21 @@
 
     if (next & lastResourceClass)
         return 0;
-    types = reallocarray(resourceTypes, next + 1, sizeof(*resourceTypes));
-    if (!types)
+    /*
+     * Preallocate one fixed array and never move it. The proprietary NVIDIA
+     * driver keeps pointers into this array across CreateNewResourceType()
+     * calls; realloc() invalidates them, causing use-after-free and heap
+     * corruption. 4096 types is far more than Xorg and its extensions use.
+     */
+#define RESOURCE_TYPE_MAX 4096
+    if (!resourceTypes) {
+        resourceTypes = calloc(RESOURCE_TYPE_MAX, sizeof(*resourceTypes));
+        if (!resourceTypes)
+            return 0;
+    }
+    if (next >= RESOURCE_TYPE_MAX)
         return 0;
+    types = resourceTypes;
 
     lastResourceType = next;
     resourceTypes = types;
@@ -638,10 +651,19 @@
         lastResourceType = RT_LASTPREDEF;
         lastResourceClass = RC_LASTPREDEF;
         TypeMask = RC_LASTPREDEF - 1;
-        free(resourceTypes);
-        resourceTypes = malloc(sizeof(predefTypes));
-        if (!resourceTypes)
-            return FALSE;
+        /*
+         * Keep one fixed, never-moving array. The proprietary NVIDIA driver
+         * caches pointers into it across CreateNewResourceType() calls.
+         */
+        if (!resourceTypes) {
+            resourceTypes = calloc(RESOURCE_TYPE_MAX, sizeof(*resourceTypes));
+            if (!resourceTypes)
+                return FALSE;
+        }
+        else {
+            memset(resourceTypes, 0,
+                   RESOURCE_TYPE_MAX * sizeof(*resourceTypes));
+        }
         memcpy(resourceTypes, predefTypes, sizeof(predefTypes));
     }
